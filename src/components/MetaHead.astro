---
import type { Locale } from '../lib/i18n';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  locale?: Locale;
  alternatePath?: string;
}

const {
  title = 'SCRITSHELL — Signal Observatory',
  description = 'Portfolio personal de SCRITSHELL.',
  image,
  noindex = false,
  locale = 'en',
  alternatePath,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
const normalizedAlternatePath = alternatePath === '/404'
  ? alternatePath
  : alternatePath?.endsWith('/') ? alternatePath : `${alternatePath}/`;
const alternate = normalizedAlternatePath && Astro.site ? new URL(normalizedAlternatePath, Astro.site) : undefined;
const defaultUrl = alternate && Astro.site
  ? (locale === 'es' ? canonical : alternate)
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#090914" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical} />}
{canonical && <link rel="alternate" hreflang={locale} href={canonical} />}
{alternate && <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternate} />}
{defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
<title>{title}</title>
