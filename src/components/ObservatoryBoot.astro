---
import heroArt from '../assets/images/scritshell-signal-observatory-hero.png';
import { getImage } from 'astro:assets';
import type { Locale } from '../lib/i18n';
import { copy } from '../lib/i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const labels = copy[locale];

const bootHero = await getImage({ src: heroArt, width: 640, format: 'webp' });
---

<div class="observatory-boot" id="observatory-boot" role="status" aria-label={labels.loading} data-boot-assets={JSON.stringify(['/icons/scritshell-orbital-mark.svg', bootHero.src])}>
  <div class="boot-instrument">
    <div class="boot-orbit boot-orbit-one" aria-hidden="true"></div>
    <div class="boot-orbit boot-orbit-two" aria-hidden="true"></div>
    <div class="boot-core" aria-hidden="true"><span></span></div>
    <img src="/icons/scritshell-orbital-mark.svg" alt="" class="boot-mark" />
  </div>
  <div class="boot-wordmark"><b>SCRITSHELL</b><span>OBSERVATORY UNIT / 01</span></div>
  <div class="boot-status"><span>{labels.bootStatus}</span><b id="boot-progress-label">8%</b></div>
  <div class="boot-progress" aria-hidden="true"><i id="boot-progress-bar" class="boot-progress-8"></i></div>
  <p class="boot-caption">{labels.bootCaption}</p>
</div>

<script is:inline src="/scripts/observatory-boot.js"></script>
