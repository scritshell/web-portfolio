---
interface Props {
  title: string;
  locale?: 'en' | 'es';
}

const { title, locale = 'en' } = Astro.props;
---

<div class="share-control">
  <button class="share-button" type="button" data-share-title={title}>{locale === 'es' ? 'Compartir' : 'Share'} <span aria-hidden="true">↗</span></button>
  <span class="share-status" aria-live="polite"></span>
</div>

<script is:inline src="/scripts/share-button.js"></script>
