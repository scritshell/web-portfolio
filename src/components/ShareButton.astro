---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="share-control">
  <button class="share-button" type="button" data-share-title={title}>Share <span aria-hidden="true">↗</span></button>
  <span class="share-status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const title = button.dataset.shareTitle ?? document.title;
      const url = window.location.href;
      const status = button.parentElement?.querySelector<HTMLElement>('.share-status');

      try {
        if (navigator.share) {
          await navigator.share({ title, url });
          return;
        }

        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link copied.';
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        if (status) status.textContent = 'Unable to copy the link.';
      }
    });
  });
</script>
