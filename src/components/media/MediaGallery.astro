---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem { src: ImageMetadata; alt: string; caption?: string; }
interface Props { items: GalleryItem[]; label: string; }
const { items, label } = Astro.props;
---

<div class="article-gallery" role="group" aria-label={label}>
  {items.map((item) => <figure class="article-media"><Image src={item.src} alt={item.alt} widths={[480, 768, 1280]} sizes="(max-width: 720px) 86vw, 50vw" loading="lazy" />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}
</div>
