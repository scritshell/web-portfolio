---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const { src, alt, caption, loading = 'lazy', sizes = '(max-width: 720px) 86vw, 720px' } = Astro.props;
---

<figure class="article-media article-media-image">
  <Image src={src} alt={alt} widths={[480, 768, 1280]} sizes={sizes} loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
