---
import { Image } from 'astro:assets';
import type { Locale } from '../../lib/i18n';
import { copy } from '../../lib/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import heroArt from '../../assets/images/scritshell-signal-observatory-hero.png';

interface Props { locale: Locale; alternatePath: string; }
const { locale, alternatePath } = Astro.props;
const t = copy[locale];
const about = locale === 'es' ? '/es/about' : '/about';
const projects = locale === 'es' ? '/es/projects' : '/projects';
const contact = locale === 'es' ? '/es/contact' : '/contact';
---

<BaseLayout locale={locale} alternatePath={alternatePath} title={locale === 'es' ? 'SCRITSHELL — Observatorio de señales' : 'SCRITSHELL — Signal Observatory'} description={locale === 'es' ? 'Portfolio personal de SCRITSHELL — Observatorio de señales.' : 'Personal portfolio of SCRITSHELL — Signal Observatory.'} image={heroArt.src}>
  <section class="hero" aria-labelledby="hero-title">
    <Image class="hero-art" src={heroArt} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-orbit orbit-one" aria-hidden="true"></div><div class="hero-orbit orbit-two" aria-hidden="true"></div>
    <div class="hero-core" aria-hidden="true"><span></span><span></span></div>
    <div class="hero-copy">
      <p class="eyebrow"><span class="pulse-dot" aria-hidden="true"></span>{t.heroEyebrow}</p>
      <h1 id="hero-title">{t.heroTitleLead}<br />{t.heroTitleTail} <em>{t.heroTitleEm}</em></h1>
      <p class="hero-intro">{t.heroIntro}</p>
      <a class="primary-action" href={projects}>{t.explore} <span aria-hidden="true">↘</span></a>
    </div>
    <aside class="hero-profile-dock" aria-label={t.exploreLabel}>
      <a class="hero-hologram hero-hologram-about" href={about}>
        <span class="hero-hologram-index">01 / {t.aboutMe}</span><strong>{t.hologramAbout}<br /><em>{t.hologramAboutEm}</em></strong>
        <span class="hero-hologram-note">{t.hologramAboutNote}</span><span class="hero-hologram-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="hero-hologram hero-hologram-projects" href={projects}>
        <span class="hero-hologram-index">02 / {t.projects.toUpperCase()}</span><strong>{t.hologramProjects}<br /><em>{t.hologramProjectsEm}</em></strong>
        <span class="hero-hologram-note">{t.hologramProjectsNote}</span><span class="hero-hologram-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="hero-hologram hero-hologram-contact" href={contact}>
        <span class="hero-hologram-index">03 / {t.contact.toUpperCase()}</span><strong>{t.hologramContact}<br /><em>{t.hologramContactEm}</em></strong>
        <span class="hero-hologram-note">scritshell@gmail.com</span><span class="hero-hologram-arrow" aria-hidden="true">↗</span>
      </a>
    </aside>
    <p class="hero-coordinate">36.7213° N · 4.4214° W</p><p class="hero-caption">Signal Observatory / 01</p>
  </section>
  <section class="intro-section" aria-labelledby="intro-title">
    <p class="section-index">01 · {locale === 'es' ? 'OBSERVATORIO' : 'OBSERVATORY'}</p>
    <div><h2 id="intro-title">{t.introTitle} <em>{t.introTitleEm}</em></h2><p>{t.introText}</p><a class="text-link" href={about}>{locale === 'es' ? 'Acerca de SCRITSHELL' : 'About SCRITSHELL'} <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
