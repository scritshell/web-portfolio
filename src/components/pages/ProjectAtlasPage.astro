---
import { getCollection } from 'astro:content';
import type { Locale } from '../../lib/i18n';
import { copy } from '../../lib/i18n';
import { localizedProjectFolders } from '../../lib/project-folders';
import BaseLayout from '../../layouts/BaseLayout.astro';
import fallbackOgImage from '../../assets/images/scritshell-signal-observatory-hero.png';

interface Props { locale: Locale; alternatePath: string; }
const { locale, alternatePath } = Astro.props;
const t = copy[locale];
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.locale === locale)).sort((a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER));
const byFolder = localizedProjectFolders[locale].map((folder) => ({ folder, projects: projects.filter((project) => project.data.folder === folder.id) }));
const stateLabel = (status: string) => status === 'in-progress' ? t.inProgress : status === 'maintained' ? t.maintained : status === 'archived' ? t.archived : t.completed;
const shortState = (status: string) => status === 'in-progress' ? (locale === 'es' ? 'ahora' : 'now') : status === 'maintained' ? (locale === 'es' ? 'activo' : 'kept') : status === 'archived' ? (locale === 'es' ? 'antiguo' : 'old') : (locale === 'es' ? 'hecho' : 'done');
const categoryLabel = (category: string) => category === 'app' ? (locale === 'es' ? 'aplicación' : 'app') : category === 'tool' ? (locale === 'es' ? 'herramienta' : 'tool') : (locale === 'es' ? 'configuración' : 'config');
const projectPath = (project: (typeof projects)[number]) => `/projects/${project.data.translationId ?? project.id}/`;
const localizedProjectPath = (project: (typeof projects)[number]) => `/es/projects/${project.data.translationId ?? project.id}/`;
---

<BaseLayout locale={locale} alternatePath={alternatePath} title={`${t.projects} — SCRITSHELL`} description={t.projectIntro} image={fallbackOgImage.src}>
  <section class="projects-page" aria-labelledby="page-title">
    <div class="projects-page-heading"><div><p class="section-index">{t.projectEyebrow}</p><h1 id="page-title">{t.projectTitle}<br /><em>{t.projectTitleEm}</em></h1></div><p class="page-lede">{t.projectIntro}</p></div>
    <div class="project-folders" aria-label={locale === 'es' ? 'Carpetas de proyectos' : 'Project folders'}>
      <div class="folder-path"><span>SCRITSHELL</span><span aria-hidden="true">›</span><b>{t.projects.toUpperCase()}</b></div>
      <div class="folder-tabs" role="tablist" aria-label={locale === 'es' ? 'Categorías de proyectos' : 'Project categories'}>
        {byFolder.map(({ folder, projects: inFolder }, index) => <button type="button" role="tab" id={`tab-${folder.id}`} aria-controls={`panel-${folder.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} class:list={['folder-tab', { active: index === 0 }]} data-folder-tab={folder.id}><span class="folder-icon" aria-hidden="true"><i></i><i></i><i></i></span><span><b>{folder.label}</b><small>{folder.note}</small></span><em aria-label={`${inFolder.length} ${locale === 'es' ? 'proyectos' : 'projects'}`}>{inFolder.length}</em></button>)}
      </div>
    </div>
    {byFolder.map(({ folder, projects: inFolder }, folderIndex) => <div class="folder-panel" id={`panel-${folder.id}`} role="tabpanel" aria-labelledby={`tab-${folder.id}`} tabindex={0} hidden={folderIndex !== 0} data-folder-panel={folder.id}>
      {inFolder.length ? <div class="pulse-console"><div class="pulse-explorer">
        <div class="pulse-stage lens-panel" aria-label={`${folder.label} ${locale === 'es' ? 'explorador visual' : 'visual explorer'}`}>
          <div class={`procedural-art ${inFolder[0].data.accent}`} aria-hidden="true"><span></span><i></i><b></b></div><div class="pulse-stage-veil" aria-hidden="true"></div><div class="stage-grid" aria-hidden="true"></div>
          <div class="stage-heading"><span>{folder.label.toUpperCase()} / {inFolder.length} {locale === 'es' ? 'SEÑALES' : 'SIGNALS'}</span><b>{t.pulseMap}</b></div>
          <div class="stage-active"><span class="pulse-dot" aria-hidden="true"></span><span data-stage-status>{stateLabel(inFolder[0].data.status)}</span><small data-stage-year>{inFolder[0].data.year > 0 ? inFolder[0].data.year : locale === 'es' ? 'Año pendiente' : 'Year pending'}</small></div>
          <div class="rhythm-lines" aria-hidden="true">{inFolder.map((project, index) => <span class:list={[index === 0 && 'is-focused', `lane-${index}`]} data-rhythm={project.data.translationId ?? project.id}><i></i><b></b><em></em></span>)}</div><div class="stage-core" aria-hidden="true"><span></span><i></i></div>
          <p class="art-caption" data-stage-caption>{inFolder[0].data.private ? t.privateContext : t.publicSignal} · {locale === 'es' ? 'señal seleccionada' : 'selected signal'}</p>
        </div>
        <div class="project-list pulse-list" aria-label={`${folder.label} ${locale === 'es' ? 'selector de proyectos' : 'project selector'}`}>
          {inFolder.map((project, index) => <button type="button" class:list={['project-node', { selected: index === 0 }]} data-project-node={project.data.translationId ?? project.id} data-status={stateLabel(project.data.status)} data-year={project.data.year > 0 ? project.data.year : locale === 'es' ? 'Año pendiente' : 'Year pending'} data-category={project.data.private ? t.privateContext : categoryLabel(project.data.category)} data-accent={project.data.accent} aria-pressed={index === 0 ? 'true' : 'false'}><span class="node-number"><i class={`node-accent ${project.data.accent}`} aria-hidden="true"></i>{String(index + 1).padStart(2, '0')}</span><span class="node-title">{project.data.title}<small>{project.data.private ? t.privateProject : categoryLabel(project.data.category)}</small></span><span class={`node-state state-${project.data.status}`}>{shortState(project.data.status)}</span><span class="node-arrow" aria-hidden="true">⌁</span></button>)}
        </div>
      </div><div class="pulse-details">
        {inFolder.map((project, index) => <article class:list={['project-detail', 'lens-panel', { 'is-active': index === 0 }]} data-project-detail={project.data.translationId ?? project.id} aria-live="polite" hidden={index !== 0}>
          <div class="detail-kicker"><span class="pulse-dot" aria-hidden="true"></span>{t.activeSignal} / {String(index + 1).padStart(2, '0')} · {project.data.year > 0 ? project.data.year : locale === 'es' ? 'Año pendiente' : 'Year pending'}</div>
          <div class="detail-main"><div><h2>{project.data.title}</h2><p>{project.data.context ?? project.data.description}</p></div><div class="detail-meta"><span>{t.whatCarries}</span><p>{project.data.description}</p><div class="tech-row">{project.data.technologies.map((technology) => <span>{technology}</span>)}</div></div></div>
          <div class="detail-status"><span class={`status-chip state-${project.data.status}`}>{stateLabel(project.data.status)}</span>{project.data.private && <span class="private-label">● {t.privateLabel}</span>}</div>
          <div class="detail-links"><a class="primary-action" href={locale === 'es' ? localizedProjectPath(project) : projectPath(project)}>{t.openRecord} <span aria-hidden="true">↗</span></a>{project.data.private ? <span class="private-label">{t.noLinks}</span> : project.data.repository ? <a class="text-link" href={project.data.repository} target="_blank" rel="noreferrer">{t.repository} ↗</a> : <span class="private-label">{t.publicLinksPending}</span>}</div>
        </article>)}
      </div></div> : <div class="folder-empty"><span class="empty-orbit" aria-hidden="true"></span><b>{t.emptyTitle}</b><p>{t.emptyText} {folder.label}.</p></div>}
    </div>)}
  </section>
  <script is:inline src="/scripts/project-atlas.js"></script>
</BaseLayout>
