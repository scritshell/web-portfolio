---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Signal lost — SCRITSHELL" description="The requested signal was not found." noindex={true}>
  <section class="standard-page lost-signal" aria-labelledby="page-title">
    <p class="section-index">404 · SIGNAL LOST</p>
    <h1 id="page-title">This coordinate is outside the observatory.</h1>
    <p class="page-lede">The signal may have moved, or it may never have been catalogued.</p>
    <div class="page-actions">
      <a class="primary-action" href="/">Return home <span aria-hidden="true">↖</span></a>
      <a class="text-link" href="/projects">Open project atlas <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/blog">Read the journal <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
