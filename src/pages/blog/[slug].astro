---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';

export async function getStaticPaths() {
  const [allPosts, allTranslated] = await Promise.all([
    getCollection('blog', ({ data }) => !data.draft && data.locale === 'en'),
    getCollection('blog', ({ data }) => !data.draft && data.locale === 'es'),
  ]);
  const posts = allPosts.filter((post) => Boolean(post.body?.trim()));
  const translated = allTranslated.filter((post) => Boolean(post.body?.trim()));
  return posts.map((post) => {
    const key = post.data.translationId ?? post.id;
    const translation = translated.find((entry) => entry.data.translationId === key);
    return { params: { slug: key }, props: { post, hasTranslation: Boolean(translation), alternatePath: translation ? `/es/blog/${key}/` : undefined } };
  });
}

const { post, hasTranslation, alternatePath } = Astro.props;
---
<BlogPostPage post={post} locale="en" hasTranslation={hasTranslation} alternatePath={alternatePath} />
