---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressLine from '../../components/ProgressLine.astro';
import ShareButton from '../../components/ShareButton.astro';
import fallbackOgImage from '../../assets/images/scritshell-signal-observatory-hero.png';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { id: post.id } }));
}

const post = await getEntry('blog', Astro.props.id);
if (!post) throw new Error(`Blog post not found: ${Astro.props.id}`);

const { Content } = await render(post);
const { data } = post;
const ogImage = (data.ogImage ?? data.cover ?? fallbackOgImage).src;
---

<BaseLayout title={`${data.title} — SCRITSHELL`} description={data.description} image={ogImage}>
  <ProgressLine />
  <article class="article-page">
    <a class="back-link" href="/blog">← Back to Blog</a>
    <header class="article-header">
      <p class="section-index">04 · JOURNAL</p>
      <p class="project-meta">{data.publishedAt.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      <h1>{data.title}</h1>
      <p class="page-lede">{data.description}</p>
      {data.tags?.length ? <ul class="tech-row">{data.tags.map((tag) => <li>{tag}</li>)}</ul> : null}
      <ShareButton title={data.title} />
    </header>
    {data.cover && <Image class="article-cover" src={data.cover} alt={data.coverAlt ?? `${data.title} cover`} widths={[768, 1280]} sizes="(max-width: 720px) 86vw, 900px" />}
    <div class="prose article-prose"><Content /></div>
  </article>
</BaseLayout>
