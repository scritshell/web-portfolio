---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroArt from '../assets/images/scritshell-signal-observatory-hero.png';
---

<BaseLayout description="Portfolio personal de SCRITSHELL — Signal Observatory." image={heroArt.src}>
  <section class="hero" aria-labelledby="hero-title">
    <Image class="hero-art" src={heroArt} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-orbit orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit orbit-two" aria-hidden="true"></div>
    <div class="hero-core" aria-hidden="true"><span></span><span></span></div>
    <div class="hero-copy">
      <p class="eyebrow"><span class="pulse-dot" aria-hidden="true"></span>Personal signal archive · 2026</p>
      <h1 id="hero-title">Tracking ideas<br />through <em>quiet systems.</em></h1>
      <p class="hero-intro">A personal observatory for software, interface experiments and tools made with care.</p>
      <a class="primary-action" href="/projects">Explore the project atlas <span aria-hidden="true">↘</span></a>
    </div>
    <p class="hero-coordinate">36.7213° N · 4.4214° W</p>
    <p class="hero-caption">Signal Observatory / 01</p>
  </section>

  <section class="intro-section" aria-labelledby="intro-title">
    <p class="section-index">01 · OBSERVATORY</p>
    <div>
      <h2 id="intro-title">A portfolio built as a record of <em>real work.</em></h2>
      <p>Projects, notes and context will live here as they are ready to be shared.</p>
      <a class="text-link" href="/about">About SCRITSHELL <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
