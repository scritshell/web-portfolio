---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projectFolders } from '../lib/project-folders';
import fallbackOgImage from '../assets/images/scritshell-signal-observatory-hero.png';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER),
);
const byFolder = projectFolders.map((folder) => ({
  folder,
  projects: allProjects.filter((project) => project.data.folder === folder.id),
}));

const stateLabel = (status: string) => status === 'in-progress' ? 'In development' : status === 'maintained' ? 'Maintained' : status === 'archived' ? 'Archived' : 'Completed';
const shortState = (status: string) => status === 'in-progress' ? 'now' : status === 'maintained' ? 'kept' : status === 'archived' ? 'old' : 'done';
---

<BaseLayout title="Projects — SCRITSHELL" description="Project atlas by SCRITSHELL." image={fallbackOgImage.src}>
  <section class="projects-page" aria-labelledby="page-title">
    <div class="projects-page-heading">
      <div>
        <p class="section-index">03 · PROJECT ATLAS</p>
        <h1 id="page-title">A field of<br /><em>working signals.</em></h1>
      </div>
      <p class="page-lede">Projects are grouped by the kind of signal they carry. Open a folder, follow a pulse, and inspect the full record when you are ready.</p>
    </div>

    <div class="project-folders" aria-label="Project folders">
      <div class="folder-path"><span>SCRITSHELL</span><span aria-hidden="true">›</span><b>PROJECTS</b></div>
      <div class="folder-tabs" role="tablist" aria-label="Project categories">
        {byFolder.map(({ folder, projects }, index) => (
          <button type="button" role="tab" id={`tab-${folder.id}`} aria-controls={`panel-${folder.id}`} aria-selected={index === 0 ? 'true' : 'false'} class={index === 0 ? 'folder-tab active' : 'folder-tab'} data-folder-tab={folder.id}>
            <span class="folder-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            <span><b>{folder.label}</b><small>{folder.note}</small></span>
            <em>{projects.length || '—'}</em>
          </button>
        ))}
      </div>
    </div>

    {byFolder.map(({ folder, projects }, folderIndex) => (
      <div class="folder-panel" id={`panel-${folder.id}`} role="tabpanel" aria-labelledby={`tab-${folder.id}`} hidden={folderIndex === 0 ? undefined : true} data-folder-panel={folder.id}>
        {projects.length ? (
          <div class="pulse-console">
            <div class="pulse-explorer">
              <div class="pulse-stage lens-panel" aria-label={`${folder.label} visual explorer`}>
                <div class={`procedural-art ${projects[0].data.accent}`} aria-hidden="true"><span></span><i></i><b></b></div>
                <div class="pulse-stage-veil" aria-hidden="true"></div>
                <div class="stage-grid" aria-hidden="true"></div>
                <div class="stage-heading"><span>{folder.label.toUpperCase()} / {projects.length} SIGNALS</span><b>pulse map</b></div>
                <div class="stage-active" data-stage-active><span class="pulse-dot"></span>{stateLabel(projects[0].data.status)}<small>{projects[0].data.year > 0 ? projects[0].data.year : 'Year pending'}</small></div>
                <div class="rhythm-lines" aria-hidden="true">{projects.map((project, index) => <span class:list={[index === 0 && 'is-focused', `lane-${index}`]} data-rhythm={project.id}><i></i><b></b><em></em></span>)}</div>
                <div class="stage-core" aria-hidden="true"><span></span><i></i></div>
                <p class="art-caption" data-stage-caption>{projects[0].data.category} · {projects[0].data.private ? 'private context' : 'public signal'}</p>
              </div>

              <div class="project-list pulse-list" aria-label={`${folder.label} project selector`}>
                {projects.map((project, index) => (
                  <a class={index === 0 ? 'project-node selected' : 'project-node'} href={`/projects/${project.id}/`} data-project-node={project.id} aria-current={index === 0 ? 'true' : undefined}>
                    <span class="node-number"><i class={`node-accent ${project.data.accent}`} aria-hidden="true"></i>{String(index + 1).padStart(2, '0')}</span>
                    <span class="node-title">{project.data.title}<small>{project.data.private ? 'Private project' : project.data.category}</small></span>
                    <span class={`node-state state-${project.data.status}`}>{shortState(project.data.status)}</span>
                    <span class="node-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="pulse-details">
              {projects.map((project, index) => (
                <article class={index === 0 ? 'project-detail lens-panel is-active' : 'project-detail lens-panel'} data-project-detail={project.id} aria-live="polite" hidden={index === 0 ? undefined : true}>
                  <div class="detail-kicker"><span class="pulse-dot"></span>Active signal / {String(index + 1).padStart(2, '0')} · {project.data.year > 0 ? project.data.year : 'Year pending'}</div>
                  <div class="detail-main"><div><h2>{project.data.title}</h2><p>{project.data.context ?? project.data.description}</p></div><div class="detail-meta"><span>What it carries</span><p>{project.data.description}</p><div class="tech-row">{project.data.technologies.map((technology) => <span>{technology}</span>)}</div></div></div>
                  <div class="detail-status"><span class={`status-chip state-${project.data.status}`}>{stateLabel(project.data.status)}</span>{project.data.private && <span class="private-label">● Private project — selected context only</span>}</div>
                  <div class="detail-links"><a class="primary-action" href={`/projects/${project.id}/`}>Open full record <span aria-hidden="true">↗</span></a>{project.data.private ? <span class="private-label">No repository or demo attached</span> : project.data.repository ? <a class="text-link" href={project.data.repository} target="_blank" rel="noreferrer">Repository ↗</a> : <span class="private-label">Public record · links pending</span>}</div>
                </article>
              ))}
            </div>
          </div>
        ) : (
          <div class="folder-empty"><span class="empty-orbit" aria-hidden="true"></span><b>This folder is still quiet.</b><p>Its first signal will appear here when the work is ready.</p></div>
        )}
      </div>
    ))}
  </section>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-folder-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-folder-panel]');
    const setFolder = (target: string) => { tabs.forEach((tab) => { const active = tab.dataset.folderTab === target; tab.setAttribute('aria-selected', String(active)); tab.classList.toggle('active', active); }); panels.forEach((panel) => { panel.hidden = panel.dataset.folderPanel !== target; }); };
    tabs.forEach((tab, index) => { tab.addEventListener('click', () => setFolder(tab.dataset.folderTab ?? 'programs')); tab.addEventListener('keydown', (event) => { if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return; event.preventDefault(); const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length]; next.focus(); setFolder(next.dataset.folderTab ?? 'programs'); }); });
    document.querySelectorAll<HTMLElement>('[data-folder-panel]').forEach((panel) => { const nodes = panel.querySelectorAll<HTMLAnchorElement>('[data-project-node]'); const details = panel.querySelectorAll<HTMLElement>('[data-project-detail]'); const stage = panel.querySelector<HTMLElement>('[data-stage-active]'); const caption = panel.querySelector<HTMLElement>('[data-stage-caption]'); const rhythms = panel.querySelectorAll<HTMLElement>('[data-rhythm]'); nodes.forEach((node) => { node.addEventListener('click', (event) => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); const id = node.dataset.projectNode; const detail = panel.querySelector<HTMLElement>(`[data-project-detail="${id}"]`); const rhythm = panel.querySelector<HTMLElement>(`[data-rhythm="${id}"]`); if (!detail) return; nodes.forEach((item) => { item.classList.toggle('selected', item === node); item.setAttribute('aria-current', item === node ? 'true' : 'false'); }); details.forEach((item) => { item.hidden = item !== detail; item.classList.toggle('is-active', item === detail); }); rhythms.forEach((item) => item.classList.toggle('is-focused', item === rhythm)); const status = detail.querySelector('.status-chip')?.textContent ?? 'Active signal'; const year = detail.querySelector('.detail-kicker')?.textContent?.split('·').pop()?.trim() ?? ''; const category = detail.querySelector('.tech-row span')?.textContent ?? 'project signal'; if (stage) stage.innerHTML = `<span class="pulse-dot"></span>${status}<small>${year}</small>`; if (caption) caption.textContent = `${category} · selected signal`; if (window.innerWidth < 900) detail.scrollIntoView({ behavior: 'smooth', block: 'center' }); }); }); });
  </script>
</BaseLayout>
