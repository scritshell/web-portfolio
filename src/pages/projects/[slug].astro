---
import { getCollection } from 'astro:content';
import ProjectRecordPage from '../../components/pages/ProjectRecordPage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && data.locale === 'en');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
---
<ProjectRecordPage project={project} locale="en" alternatePath={`/es/projects/${project.data.translationId ?? project.id}/`} />
